# =============================================================================
# Codebase Companion — environment variables
# =============================================================================
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# Lines beginning with # are comments and are ignored.
# .env is listed in .gitignore — never commit it with real secrets.
# =============================================================================


# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Your OpenAI API key  (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...


# ── OPTIONAL — LLM model & retrieval ─────────────────────────────────────────

# Which OpenAI chat model to use.
# Options: gpt-3.5-turbo (cheap/fast), gpt-4o (better quality), gpt-4-turbo
OPENAI_MODEL=gpt-3.5-turbo

# How many code chunks the AnalyzerAgent retrieves from ChromaDB per query.
# Higher = broader context but more tokens consumed per LLM call.
RETRIEVER_K=4


# ── OPTIONAL — storage paths ──────────────────────────────────────────────────

# Directory where ChromaDB persists embedding vectors between runs.
# Delete this folder to force a full re-ingestion on next run.
CHROMA_DIR=chroma_db

# Directory where cloned GitHub repositories are cached locally.
# A repo is only cloned once; re-running with the same URL reuses the cache.
REPOS_DIR=data/repos


# ── OPTIONAL — pipeline limits ────────────────────────────────────────────────

# Maximum number of source files each agent processes per run.
# Increase for deeper analysis; decrease for faster / cheaper runs.
MAX_FILES=3
